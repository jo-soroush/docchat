# Local-only Ollama runtime configuration. Copy to .env; never commit .env.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Local Gradio UI port. Override only if this port is already in use.
GRADIO_SERVER_PORT=7860

# Re-research attempts allowed after an unsuccessful verification (0-5).
MAX_VERIFICATION_RETRIES=2

# Persistent vector-store location and collection. Existing legacy collection data is not deleted.
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=documents
