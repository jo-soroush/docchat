# Local-only Ollama runtime configuration. Copy to .env; never commit .env.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Maximum texts per local Ollama embedding request (1-256).
OLLAMA_EMBEDDING_BATCH_SIZE=32
# Local Ollama context capacity for chat/structured generation (1024-65536).
OLLAMA_CONTEXT_WINDOW=8192

# Maximum character length of an embedding-safe document chunk (256-16000).
DOCUMENT_CHUNK_MAX_CHARACTERS=4000

# Local Gradio UI port. Override only if this port is already in use.
GRADIO_SERVER_PORT=7860

# Re-research attempts allowed after an unsuccessful verification (0-5).
MAX_VERIFICATION_RETRIES=2

# Persistent vector-store location and collection. Existing legacy collection data is not deleted.
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=documents

# Maximum bounded active-document chunks supplied to synthesis/comparison operations.
SYNTHESIS_EVIDENCE_MAX_CHUNKS=12
